<Window x:Class="SpellBreaker.LoadingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SpellBreaker" Width="420" Height="230"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen" Topmost="True"
        Background="Transparent" AllowsTransparency="True">
    <Border CornerRadius="10" Padding="28" Background="{DynamicResource BodyBg}"
            BorderBrush="{DynamicResource Accent}" BorderThickness="1.5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Path Data="{StaticResource MagicIcon}" Fill="{DynamicResource Accent}"
                          Width="30" Height="30" Stretch="Uniform"
                          Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="SpellBreaker" FontSize="30" FontWeight="Bold"
                               FontFamily="Verdana" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="VersionText" HorizontalAlignment="Center" Margin="0,2,0,0"
                           Foreground="{DynamicResource Accent}" FontSize="13" FontWeight="SemiBold"/>
            </StackPanel>

            <TextBlock Grid.Row="1" x:Name="StatusText" HorizontalAlignment="Center" Margin="0,10,0,6"
                       Foreground="{DynamicResource DimFg}" FontSize="12"
                       TextTrimming="CharacterEllipsis"/>

            <ProgressBar Grid.Row="2" x:Name="Bar" Height="8" Minimum="0" Maximum="100"
                         Foreground="{DynamicResource Accent}" Background="{DynamicResource InputBg}"/>
        </Grid>
    </Border>
</Window>
