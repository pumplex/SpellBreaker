<Window x:Class="SpellBreaker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SpellBreaker" Width="560" Height="600" MinWidth="480" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
    <Grid>
        <!-- ======================= LAUNCHER ======================= -->
        <Border x:Name="LauncherPanel" Background="{DynamicResource BodyBg}" Margin="10" Padding="10">
            <Grid>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                        <Path Data="{StaticResource MagicIcon}" Fill="{DynamicResource Accent}"
                              Width="22" Height="22" Stretch="Uniform"
                              Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="AppTitle" FontSize="20" FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock x:Name="SysLangLabel" Foreground="{DynamicResource Legend}" FontWeight="Bold"/>
                        <TextBlock Text=": " />
                        <TextBlock x:Name="SysLangValue"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <TextBlock x:Name="AppLangLabel" Foreground="{DynamicResource Legend}" FontWeight="Bold"/>
                        <TextBlock Text=": " />
                        <TextBlock x:Name="AppLangValue"/>
                    </StackPanel>
                    <Button x:Name="ContinueButton" Style="{StaticResource GreenButton}" Click="ContinueClicked"/>
                    <Button x:Name="CancelButton" Style="{StaticResource RedButton}" Click="CancelClicked"/>
                </StackPanel>
                <Button x:Name="OptionsButton" Style="{StaticResource ThemedButton}"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="OptionsClicked"/>
            </Grid>
        </Border>

        <!-- ======================= SELECTOR (hosted page) ======================= -->
        <Border x:Name="SelectorPanel" Background="{DynamicResource BodyBg}" Margin="0"
                Visibility="Collapsed"/>

        <!-- ======================= OPTIONS (hosted page) ======================= -->
        <Border x:Name="OptionsPanel" Background="{DynamicResource BodyBg}" Margin="0"
                Visibility="Collapsed"/>

        <!-- ======================= PROGRESS ======================= -->
        <Border x:Name="ProgressPanel" Background="{DynamicResource BodyBg}" Margin="10" Padding="10"
                Visibility="Collapsed" PreviewMouseDown="ProgressPanelClicked">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="ModifyTitle" FontSize="16" FontWeight="Bold" Margin="4"/>

                <ScrollViewer Grid.Row="1" x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="LogList" FontFamily="Consolas" FontSize="13"/>
                </ScrollViewer>

                <TextBlock Grid.Row="2" x:Name="StatusLine" Foreground="{DynamicResource DimFg}"
                           Margin="4" TextTrimming="CharacterEllipsis"/>

                <ProgressBar Grid.Row="3" x:Name="Progress" Height="20" Margin="4"
                             Minimum="0" Maximum="100" Value="0"/>

                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center"
                            Margin="0,8,0,0">
                    <Button x:Name="ProgressBackButton" Style="{StaticResource ThemedButton}"
                            Click="ProgressBackClicked" Visibility="Collapsed"/>
                    <TextBlock x:Name="CountdownText" VerticalAlignment="Center" Margin="10,0,0,0"
                               Foreground="{DynamicResource DimFg}" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>

    <TextBlock Grid.Row="1" HorizontalAlignment="Center" FontSize="11"
               Foreground="{DynamicResource DimFg}" Margin="0,0,0,4">
        <Hyperlink NavigateUri="https://github.com/pumplex/SpellBreaker"
                   RequestNavigate="FooterLinkNavigate"
                   Foreground="{DynamicResource DimFg}">Copyright (c) 2026 PumpleX</Hyperlink>
    </TextBlock>
    </Grid>
</Window>
